{
  "title": "Alitycs Analytics Event Schema",
  "description": "Unified event structure for all Alitycs Analytics SDKs",
  "version": "0.4.0",
  "definitions": {
    "RevenuePayload": {
      "oneOf": [
        {
          "type": "object",
          "required": ["version", "kind", "factId", "amount", "currency"],
          "properties": {
            "version": { "const": 1 },
            "kind": { "const": "transaction" },
            "factId": { "type": "string" },
            "amount": { "type": "string" },
            "currency": { "type": "string" },
            "customerId": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["version", "kind", "factId", "subscriptionId", "customerId", "mrrAmount", "currency"],
          "properties": {
            "version": { "const": 1 },
            "kind": { "const": "mrr_snapshot" },
            "factId": { "type": "string" },
            "subscriptionId": { "type": "string" },
            "customerId": { "type": "string" },
            "mrrAmount": { "type": "string" },
            "currency": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["version", "kind", "factId", "currency", "expectedActiveSubscriptions"],
          "properties": {
            "version": { "const": 1 },
            "kind": { "const": "mrr_baseline_complete" },
            "factId": { "type": "string" },
            "currency": { "type": "string" },
            "expectedActiveSubscriptions": { "type": "integer" }
          },
          "additionalProperties": false
        }
      ]
    },
    "AnalyticsEvent": {
      "type": "object",
      "required": ["eventId", "event", "eventType", "anonymousId", "sessionId", "timestamp", "properties", "context"],
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique identifier for the event"
        },
        "event": {
          "type": "string",
          "description": "Event name/type"
        },
        "eventType": {
          "type": "string",
          "enum": ["track", "identify", "page", "error"],
          "description": "Category of the event"
        },
        "userId": {
          "type": "string",
          "description": "Identified user ID"
        },
        "anonymousId": {
          "type": "string",
          "description": "Anonymous user identifier"
        },
        "sessionId": {
          "type": "string",
          "description": "Session identifier"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp in milliseconds"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Event-specific properties (all values as strings)"
        },
        "revenue": {
          "$ref": "#/definitions/RevenuePayload"
        },
        "dedupeKey": {
          "type": "string",
          "description": "Optional client-side deduplication key"
        },
        "context": {
          "$ref": "#/definitions/EventContext"
        }
      }
    },
    "EventContext": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "description": "User locale (e.g., en-US)"
        },
        "timezone": {
          "type": "string",
          "description": "User timezone"
        },
        "userAgent": {
          "type": "string",
          "description": "Browser user agent string"
        },
        "url": {
          "type": "string",
          "description": "Current page URL"
        },
        "referrer": {
          "type": "string",
          "description": "Page referrer (from ?referrer= or ?ref= or document.referrer)"
        },
        "screen": {
          "type": "object",
          "properties": {
            "width": {
              "type": "string"
            },
            "height": {
              "type": "string"
            }
          }
        },
        "sdkVersion": {
          "type": "string",
          "description": "SDK version (e.g., 2.0.0)"
        },
        "sdkLanguage": {
          "type": "string",
          "description": "SDK language (e.g., typescript)"
        },
        "utmSource": {
          "type": "string",
          "description": "UTM source parameter"
        },
        "utmMedium": {
          "type": "string",
          "description": "UTM medium parameter"
        },
        "utmCampaign": {
          "type": "string",
          "description": "UTM campaign parameter"
        },
        "utmContent": {
          "type": "string",
          "description": "UTM content parameter"
        },
        "utmTerm": {
          "type": "string",
          "description": "UTM term parameter"
        }
      },
      "required": ["sdkVersion", "sdkLanguage"],
      "additionalProperties": true
    },
    "BatchPayload": {
      "type": "object",
      "required": ["events", "batchId", "sentAt"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnalyticsEvent"
          }
        },
        "batchId": {
          "type": "string",
          "description": "Unique batch identifier"
        },
        "sentAt": {
          "type": "integer",
          "description": "Unix timestamp when batch was sent"
        }
      }
    }
  }
}
