{
  "name": "@alitycs/browser-snippet",
  "version": "1.0.1",
  "description": "Ultra-lightweight analytics snippet (~1KB) for drop-in integration",
  "main": "dist/snippet.js",
  "types": "dist/snippet.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:dev && bun run build:prod",
    "build:dev": "bun build src/snippet.ts --outfile=dist/snippet.js --target=browser --format=iife --sourcemap=inline",
    "build:prod": "bun build src/snippet.ts --outfile=dist/snippet.min.js --target=browser --format=iife --minify",
    "build:watch": "bun build src/snippet.ts --outfile=dist/snippet.js --target=browser --format=iife --sourcemap=inline --watch",
    "test": "bun run build:prod && bun test",
    "test:coverage": "bun run build:prod && bun test --coverage",
    "test:watch": "bun test --watch",
    "test:size": "bun test tests/size.test.ts",
    "dev": "bun run build:watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts"
  },
  "keywords": [
    "analytics",
    "snippet",
    "tracking",
    "loader",
    "lightweight",
    "alitycs"
  ],
  "author": "Alitycs Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.5",
    "bun-types": "^1.3.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alitycs/alitycs-sdk-js.git",
    "directory": "sdks/browser-snippet"
  },
  "homepage": "https://github.com/alitycs/alitycs-sdk-js/tree/main/sdks/browser-snippet#readme",
  "bugs": {
    "url": "https://github.com/alitycs/alitycs-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
