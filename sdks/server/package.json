{
  "name": "@alitycs/server",
  "version": "0.1.0",
  "description": "Stateless server-side analytics SDK for Node and Bun — explicit per-call identity, person aliases, and traits",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun build src/index.ts --outfile=dist/index.esm.js --target=node --format=esm --external @alitycs/core",
    "build:cjs": "bun build src/index.ts --outfile=dist/index.js --target=node --format=cjs --external @alitycs/core",
    "build:types": "tsc -p tsconfig.build.json",
    "build:all": "bun run build && bun run build:cjs && bun run build:types",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "dev": "bun run --hot src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts"
  },
  "dependencies": {
    "@alitycs/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.5",
    "bun-types": "^1.3.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alitycs/alitycs-sdk-js.git",
    "directory": "sdks/server"
  },
  "homepage": "https://github.com/alitycs/alitycs-sdk-js/tree/main/sdks/server#readme",
  "bugs": {
    "url": "https://github.com/alitycs/alitycs-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "analytics",
    "tracking",
    "typescript",
    "javascript",
    "sdk",
    "events",
    "server",
    "node",
    "bun"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
